@startuml state-car
!include _style.iuml
title Діаграма станів боліда (CarState і PostRaceStage)

[*] --> OnTrack : Race.Start()\nPlaceOnGrid()

OnTrack --> InPitLane : EnterPitLane()\n[ShouldPit() = true]
InPitLane --> PitStop : MoveInPitLane()\n[доїхав до боксу]
PitStop --> InPitLane : TickStop()\n[механіки закінчили]\n/ ChangeTyres()
InPitLane --> OnTrack : MoveInPitLane()\n[виїзд з піт-лейну]

OnTrack --> Finished : Finish()\n[клетчастий прапор]
InPitLane --> Finished : Finish()
OnTrack --> Retired : Retire()\n[технічна несправність]

state Finished {
  [*] --> CoolDownLap : очки нараховано,\nпротокол остаточний
  CoolDownLap : коло охолодження,\n60 % темпу
  CoolDownLap --> PitLane : EnterParcFerme()\n[проїхав коло]
  PitLane : в'їзд у парк-ферме
  PitLane --> Parked : MoveToParcFerme()\n[доїхав до місця]
  Parked : трійка — окремо,\nінші — у боксах
}

Finished --> [*] : усі в парк-ферме\n(CarsParked)
Retired --> [*]
@enduml
